{
  "hosting": {
    "site": "rydee-web",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      { "source": "/en", "destination": "/", "type": 301 },
      { "source": "/en/:page", "destination": "/:page", "type": 301 },
      { "source": "/pomoc", "destination": "/pl/help", "type": 301 },
      { "source": "/prywatnosc", "destination": "/pl/privacy", "type": 301 },
      { "source": "/kontakt", "destination": "/pl/contact", "type": 301 },
      { "source": "/licencje", "destination": "/pl", "type": 301 },
      { "source": "/licenses", "destination": "/", "type": 301 },
      { "source": "/:lang/licenses", "destination": "/:lang", "type": 301 }
    ],
    "headers": [
      { "source": "/help/*.json", "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ] },
      { "source": "/_astro/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://europe-central2-rydee-cloud.cloudfunctions.net; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" }
      ] }
    ]
  }
}
