---
// Języki z przedrostkiem w adresie (`/pl/...`); EN - `src/pages/privacy.astro`.
import Privacy from '../../views/Privacy.astro';
import { prefixedLangs, type Lang } from '../../site';
export const getStaticPaths = () => prefixedLangs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---
