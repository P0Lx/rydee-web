---
// Języki z przedrostkiem w adresie (`/pl/...`); EN - `src/pages/contact.astro`.
import Contact from '../../views/Contact.astro';
import { prefixedLangs, type Lang } from '../../site';
export const getStaticPaths = () => prefixedLangs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---
<Contact lang={lang} />
