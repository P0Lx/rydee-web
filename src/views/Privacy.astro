---
import Base from '../layouts/Base.astro';
import { company, ui, type Lang } from '../site';
import { privacy } from '../data/privacy';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const p = privacy[lang];
const fill = (key: string) => `<mark class="fill">${key}: ${ui[lang].fill}</mark>`;
const names: Record<string, string> = lang === 'pl'
  ? { name: 'nazwa firmy', address: 'adres', taxId: 'NIP', email: 'e-mail' }
  : { name: 'company name', address: 'address', taxId: 'tax ID', email: 'e-mail' };
const render = (html: string) => html.replace(/\{\{(\w+)\}\}/g, (_, k: keyof typeof company) => company[k] ?? fill(names[k]));
---
<Base lang={lang} route="privacy" title={p.meta} description={p.desc}>
  <section class="page-hero wrap">
    <h1>{p.h}</h1>
    <p class="muted">{p.lead}</p>
    <p class="mono muted" style="font-size:.85rem">{p.updated}</p>
  </section>
  <section class="wrap">
    <h2 class="dm">{p.mapTitle}</h2>
    <div class="flows">
      <div class="fr fh muted"><span>{p.head[0]}</span><span>{p.head[1]}</span><span>{p.head[2]}</span></div>
      {p.map.map(([a, b, c]) => <div class="fr"><b>{a}</b><span>{b}</span><span class="to">{c}</span></div>)}
    </div>
  </section>
  <section class="wrap legal">
    <nav class="toc" aria-label={p.legalTitle}>
      <div class="eyebrow">{p.legalTitle}</div>
      {p.sections.map((s) => <a href={`#${s.id}`}>{s.title}</a>)}
    </nav>
    <div class="doc">
      {p.sections.map((s, i) => (
        <section id={s.id}>
          <h2><span class="mono n">{String(i + 1).padStart(2, '0')}</span>{s.title}</h2>
          <div set:html={render(s.body)} />
        </section>
      ))}
    </div>
  </section>
</Base>
<style is:global>
.dm { font-size: 1.9rem; margin: 24px 0 18px; }
.flows { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 6px 24px; }
.fr { display: grid; grid-template-columns: 1.1fr 1.5fr 1.1fr; gap: 18px; padding: 14px 0; border-top: 1px solid var(--line); font-size: .98rem; }
.fr b { font-weight: 600; }
.fh { border-top: 0; font: 500 .82rem var(--mono); padding-bottom: 8px; }
.to { color: var(--accent-text); }
.fh .to { color: inherit; }
@media (max-width: 720px) { .fh { display: none; } .fr { grid-template-columns: 1fr; gap: 2px; } .fr:nth-child(2) { border-top: 0; } }
.legal { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 60px; margin-top: 90px; }
.toc { position: sticky; top: 100px; align-self: start; display: grid; gap: 3px; font-size: .92rem; max-height: calc(100svh - 120px); overflow-y: auto; }
.toc .eyebrow { margin-bottom: 8px; }
.toc a { text-decoration: none; color: var(--muted); padding: 4px 0; }
.toc a:hover { color: var(--ink); }
.doc { max-width: 72ch; display: grid; gap: 44px; }
.doc h2 { font-size: 1.6rem; margin-bottom: 12px; display: flex; gap: 12px; align-items: baseline; line-height: 1.15; }
.doc .n { font-size: .85rem; color: var(--accent-text); letter-spacing: 0; }
.doc p + p { margin-top: 12px; }
.doc ul { padding-left: 20px; margin: 0; display: grid; gap: 8px; }
.doc b { font-weight: 600; }
#health-connect, #strava { padding: 22px 24px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
@media (max-width: 860px) { .legal { grid-template-columns: 1fr; gap: 34px; } .toc { position: static; max-height: none; } }
</style>
