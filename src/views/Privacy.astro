---
import Base from '../layouts/Base.astro';
import { company, ui, type Lang } from '../site';
import { privacy } from '../data/privacy';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const p = privacy[lang];
const fill = (key: string) => `<mark class="fill">${key}: ${ui[lang].fill}</mark>`;
const names: Record<string, string> = lang === 'pl'
  ? { name: 'nazwa firmy', address: 'adres', taxId: 'NIP', email: 'e-mail' }
  : { name: 'company name', address: 'address', taxId: 'tax ID', email: 'e-mail' };
const render = (html: string) => html.replace(/\{\{(\w+)\}\}/g, (_, k: keyof typeof company) => company[k] ?? fill(names[k]));
const num = (i: number) => (lang === 'pl' ? `§ ${i + 1}` : `${i + 1}.`);
---
<Base lang={lang} route="privacy" title={p.meta} description={p.desc}>
  <section class="page-hero wrap legal-hero">
    <h1>{p.h}</h1>
    <p>{p.lead}</p>
    <p class="muted when">{p.updated}</p>
  </section>
  <section class="wrap legal">
    <nav class="toc" aria-label={p.legalTitle}>
      <div class="toc-t">{p.legalTitle}</div>
      {p.sections.map((s, i) => <a href={`#${s.id}`}>{num(i)} {s.title}</a>)}
    </nav>
    <div class="doc">
      {p.sections.map((s, i) => (
        <section id={s.id} style={`--sec:${i + 1}`}>
          <h2><span class="n">{num(i)}</span> {s.title}</h2>
          <div set:html={render(s.body)} />
        </section>
      ))}
    </div>
  </section>
</Base>
<style is:global>
.legal-hero h1 { font-size: clamp(2.4rem, 5.4vw, 3.8rem); }
.legal-hero p { font-size: 1.05rem; }
.legal-hero .when { font-size: .95rem; margin-top: 10px; }
.legal { display: grid; grid-template-columns: 270px minmax(0, 1fr); gap: 60px; margin-top: 30px; border-top: 1px solid var(--line); padding-top: 40px; }
.toc { position: sticky; top: 100px; align-self: start; display: grid; gap: 3px; font-size: .9rem; line-height: 1.35; max-height: calc(100svh - 120px); overflow-y: auto; }
.toc-t { font-weight: 600; margin-bottom: 8px; }
.toc a { text-decoration: none; color: var(--muted); padding: 4px 0; }
.toc a:hover { color: var(--ink); }
.doc { max-width: 76ch; display: grid; gap: 34px; }
.doc section { counter-reset: pt; scroll-margin-top: 96px; }
.doc h2 { font: 600 1.25rem/1.25 var(--sans); letter-spacing: 0; margin-bottom: 12px; }
.doc .n { font-variant-numeric: tabular-nums; }
.doc b { font-weight: 600; }
.doc ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
.doc ol > li { position: relative; padding-left: 40px; counter-increment: pt; }
.doc ol > li::before { content: counter(pt) "."; position: absolute; left: 0; color: var(--muted); font-variant-numeric: tabular-nums; }
.doc ul { list-style: lower-alpha; padding-left: 22px; margin: 9px 0 0; display: grid; gap: 7px; }
@media (max-width: 860px) { .legal { grid-template-columns: minmax(0, 1fr); gap: 34px; } .toc { position: static; max-height: none; } }
</style>
