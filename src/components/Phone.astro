---
// Podgląd aplikacji Rydee w sekcji „przejazd” (styl Alrydee, ciemny):
// ekran główny (blok prędkości jak w aplikacji, kafelki 2 × 3, widget),
// szczegóły przejazdu i lista przejazdów. Wartości ustawia `ride.ts`.
import type { Lang } from '../site';
interface Props { labels: Record<string, string>; lang: Lang; id?: string; }
const { labels: t, lang, id } = Astro.props;
const tiles = [['time', t.time, '0:00'], ['dist', t.dist, '0'], ['hr', t.hr, '118'], ['cad', t.cad, '84'], ['ele', t.ele, '210'], ['grade', t.grade, '0%']];
const bars = Array.from({ length: 26 }, (_, i) => 38 + Math.round(30 * Math.abs(Math.sin(i * 0.6)) + 18 * Math.abs(Math.sin(i * 0.23))));
const route = 'M20 135C60 120 58 82 100 76s60 30 92 12 26-58 70-70';
// trasa w szczegółach przejazdu (wymyślona, jak cały przejazd na stronie)
const ridePath = 'M44 236C30 200 62 178 92 170s38-40 70-52 58 6 76-22 6-58 30-72';
// wartości z przecinkiem dziesiętnym poza EN, daty w języku strony
const num = (v: number, d = 1) => v.toFixed(d).replace('.', lang === 'en' ? '.' : ',');
const date = (iso: string, opts: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(lang, { ...opts, timeZone: 'UTC' }).format(new Date(iso));
const when = date('2026-11-15T08:12:00Z', { weekday: 'long', day: 'numeric', month: 'long' }) + ' · 08:12';
const rides = [
  { d: '2026-11-15T08:12:00Z', km: 62, time: '2:31', up: 620, path: 'M5 30C4 22 10 20 14 19s6-6 10-8 8 1 10-3 1-7 4-9' },
  { d: '2026-11-12T17:40:00Z', km: 34.8, time: '1:22', up: 210, path: 'M6 8c8 2 6 10 14 12s12-6 14 4-10 10-16 8' },
  { d: '2026-11-09T09:05:00Z', km: 48.3, time: '1:55', up: 415, path: 'M4 26c6-10 12-4 16-12s10-8 14-2-2 14 2 18' },
  { d: '2026-11-07T07:30:00Z', km: 21.5, time: '0:51', up: 90, path: 'M5 20c6-8 12-12 18-8s6 10 12 6' },
  { d: '2026-11-04T16:20:00Z', km: 41.2, time: '1:38', up: 330, path: 'M6 32c2-10 10-6 12-14s10-12 16-6' },
  { d: '2026-11-01T10:00:00Z', km: 87.6, time: '3:24', up: 980, path: 'M4 12c10-4 8 8 16 10s6 12 14 12' },
];
// nagłówek grupy jak na liście w aplikacji: miesiąc i rok
const month = date(rides[0].d, { month: 'long', year: 'numeric' });
---
<div class="phone" id={id} data-screen="ride" role="img" aria-label={t.aria}>
  <div class="ph-screen">
    <div class="ph-view ph-main">
      <div class="ph-speed">
        <canvas data-gauge aria-hidden="true"></canvas>
        <span class="ph-btn ph-menu" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg></span>
        <span class="ph-btn ph-pause" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 6v12M15 6v12"/></svg></span>
      </div>
      <div class="ph-tiles">
        {tiles.map(([k, label, v]) => <div class="tile"><span><i></i>{label}</span><b data-v={k}>{v}</b></div>)}
      </div>
      <div class="ph-widget">
        <div class="w on" data-w="map"><svg viewBox="0 0 280 150" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g class="m-roads"><path d="M-10 40 300 90M60-10 110 170M210-10 170 170M-10 120 300 30"/></g><path class="m-track" pathLength="100" d={route}/><path class="m-done" pathLength="100" d={route}/><circle class="m-pin" r="5.5" cx="20" cy="135"/></svg><em>{t.map}</em></div>
        <div class="w" data-w="hr"><div class="bars" aria-hidden="true">{bars.map((h) => <i style={`height:${h}%`} />)}</div><em>{t.hrw}</em></div>
        <div class="w" data-w="climb"><svg viewBox="0 0 280 150" preserveAspectRatio="none" aria-hidden="true"><path class="c-area" d="M0 150V134C60 128 110 114 160 92s80-28 120-32V150z"/></svg><div class="wb"><b data-v="vam">0</b><span>VAM m/h</span></div><em>{t.climb}</em></div>
      </div>
      <div class="ph-radar" aria-hidden="true"><i></i><i></i></div>
    </div>

    <div class="ph-view ph-details" aria-hidden="true">
      <svg class="dt-map" viewBox="0 -30 300 400" preserveAspectRatio="xMidYMid slice">
        <g class="m-roads"><path d="M-60 70 360 150M70-80 150 420M250-80 180 420M-60 270 360 20M-60 190 120 230M-60 330 360 300"/></g>
        <path class="dt-track" d={ridePath} />
        <circle class="dt-start" cx="44" cy="236" r="6"/>
        <g class="dt-finish" transform="translate(268 74)"><circle r="10"/><path d="M-3 5.5v-11h7.5l-1.8 2.8 1.8 2.8h-7.5"/></g>
        <circle class="dt-cursor" r="7" cx="44" cy="236"/>
      </svg>
      <div class="dt-sheet">
        <i class="dt-grip"></i>
        <div class="dt-date">{when}</div>
        <div class="dt-stats">
          <div><b>{num(62)}</b><span>km</span></div>
          <div><b>2:31</b><span>{t.moving}</span></div>
          <div><b>620</b><span>m ↑</span></div>
        </div>
        <div class="dt-chart">
          <svg viewBox="0 0 300 90" preserveAspectRatio="none"><path class="dt-fill"/><path class="dt-line"/></svg>
          <i class="dt-scrub"><b data-v="scrub">210 m</b></i>
        </div>
      </div>
    </div>

    <div class="ph-view ph-rides" aria-hidden="true">
      <div class="rl-title">{t.rides}</div>
      <div class="rl-month">{month}</div>
      <div class="rl-list">
        {rides.map((r, i) => (
          <div class:list={['rl-row', { new: i === 0 }]}>
            <svg viewBox="0 0 40 40"><path d={r.path}/></svg>
            <div><b>{date(r.d, { weekday: 'short', day: 'numeric', month: 'short' })}</b><span>{num(r.km)} km · {r.time} · {r.up} m</span></div>
          </div>
        ))}
      </div>
      <div class="rl-local"><svg viewBox="0 0 24 24"><rect x="6" y="2.5" width="12" height="19" rx="3"/><path d="M10 18.5h4"/><path d="M9.5 10.5l2 2 3.5-4"/></svg>{t.local}</div>
    </div>
  </div>
</div>
<style is:global>
/* Alrydee, ciemny (`OnboardingColors`): noc, grafitowe karty, koral */
.phone { --p-bg:#15171D; --p-card:#23262E; --p-ink:#fff; --p-mut:#9C9AA6; --p-line:#343844; --p-acc:#F2553F; --p-map:#1D2029; --p-road:#2C303B;
  width: 300px; max-width: 100%; aspect-ratio: 9/19; padding: 8px; border-radius: 42px; background: #000; border: 1px solid #383a41; box-shadow: 0 40px 90px -30px rgba(0,0,0,.8); container-type: inline-size; }
.ph-screen { height: 100%; border-radius: 34px; overflow: hidden; background: var(--p-bg); color: var(--p-ink); position: relative; font-family: var(--sans); }
.ph-view { position: absolute; inset: 0; transition: opacity .45s, translate .45s cubic-bezier(.3,.7,.2,1); }
.phone:not([data-screen='ride']) .ph-main, .phone:not([data-screen='details']) .ph-details, .phone:not([data-screen='rides']) .ph-rides { opacity: 0; translate: 0 4%; pointer-events: none; }

/* ekran główny: blok prędkości, kafelki 2 × 3, widget - karty 20, odstęp 8 jak w aplikacji */
.ph-main { display: flex; flex-direction: column; gap: 2cqw; padding: 7cqw 3cqw 3cqw; }
.ph-speed { position: relative; flex: 0 0 52cqw; background: var(--p-card); border-radius: 5.5cqw; }
.ph-speed canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
.ph-btn { position: absolute; top: 2.4cqw; width: 10.5cqw; height: 10.5cqw; display: grid; place-items: center; border-radius: 50%; background: rgba(242,85,63,.2); color: var(--p-acc); }
.ph-menu { left: 2.4cqw; }
.ph-pause { right: 2.4cqw; }
.ph-btn svg { width: 6.6cqw; height: 6.6cqw; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
.ph-tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 2cqw; flex: 0 0 auto; }
.tile { height: 15.5cqw; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .6cqw; background: var(--p-card); border-radius: 4.5cqw; min-width: 0; font-stretch: 85%; }
.tile span { display: flex; align-items: center; gap: 1.2cqw; font-size: 3cqw; line-height: 1; color: var(--p-mut); white-space: nowrap; }
.tile span i { width: 2.4cqw; height: 2.4cqw; border-radius: 50%; background: var(--p-acc); }
/* stała wysokość wartości: jedna wysokość wiersza i cyfry tabelaryczne */
.tile b { display: block; height: 7.4cqw; font: 500 7.4cqw/1 var(--sans); font-variant-numeric: tabular-nums; }
.ph-widget { position: relative; flex: 1; min-height: 0; background: var(--p-card); border-radius: 5.5cqw; overflow: hidden; }
.w { position: absolute; inset: 0; opacity: 0; transition: opacity .35s; }
.w.on { opacity: 1; }
.w > svg { width: 100%; height: 100%; }
.w[data-w='map'] { background: var(--p-map); }
.w em { position: absolute; left: 3.4cqw; top: 2.6cqw; font: 500 3.4cqw var(--sans); color: var(--p-mut); }
.m-roads path { stroke: var(--p-road); stroke-width: 7; fill: none; }
/* jak `MapView` w aplikacji: trasa morska, ślad i pozycja koralowe */
.m-track, .m-done { fill: none; stroke-width: 3.5; stroke-linecap: round; }
.m-track { stroke: #1E9C9A; }
.m-done { stroke: #F2553F; stroke-dasharray: 0 100; }
.m-pin { fill: #F2553F; stroke: #fff; stroke-width: 2.5; }
.bars { position: absolute; inset: 22% 3cqw 3cqw; display: flex; align-items: end; gap: .8cqw; }
.bars i { flex: 1; background: var(--p-acc); border-radius: 2px 2px 0 0; }
.c-area { fill: var(--p-acc); opacity: .75; }
.wb { position: absolute; right: 3.4cqw; top: 2.4cqw; display: grid; justify-items: end; gap: .4cqw; }
.wb b { font: 500 7.5cqw/1 var(--sans); font-variant-numeric: tabular-nums; display: block; }
.wb span { font-size: 3cqw; color: var(--p-mut); }
.ph-radar { position: absolute; right: 0; top: 9%; bottom: 9%; width: 1.8cqw; }
.ph-radar i { position: absolute; left: 0; width: 100%; height: 6cqw; background: var(--p-acc); border-radius: 2px 0 0 2px; opacity: 0; transition: opacity .2s; }
.phone.radar .ph-radar i { opacity: 1; }

/* szczegóły przejazdu: mapa z całym śladem, arkusz z liczbami i wykresem */
.ph-details { background: var(--p-map); }
.dt-map { position: absolute; inset: 0 0 auto; width: 100%; height: 62%; }
.dt-track { fill: none; stroke: #F2553F; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 1.5px rgba(0,0,0,.6)); }
.dt-start { fill: #fff; stroke: #F2553F; stroke-width: 3.5; }
.dt-finish circle { fill: #22263A; stroke: #fff; stroke-width: 2.4; }
.dt-finish path { fill: #fff; stroke: #fff; stroke-width: 1; stroke-linejoin: round; }
.dt-cursor { fill: #fff; stroke: #F2553F; stroke-width: 4; filter: drop-shadow(0 1px 3px rgba(0,0,0,.5)); }
.dt-sheet { position: absolute; inset: auto 0 0; height: 47%; padding: 2.4cqw 4cqw 4cqw; display: flex; flex-direction: column; gap: 2.6cqw; background: var(--p-bg); border-radius: 6cqw 6cqw 0 0; box-shadow: 0 -8px 24px rgba(0,0,0,.35); }
.dt-grip { align-self: center; width: 10cqw; height: 1.2cqw; border-radius: 1cqw; background: var(--p-line); }
.dt-date { font-size: 3.6cqw; color: var(--p-mut); text-align: center; }
.dt-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; }
.dt-stats div { display: grid; justify-items: center; padding: 2.2cqw 1cqw; background: var(--p-card); border-radius: 4.5cqw; font-stretch: 85%; }
.dt-stats b { font: 500 6.4cqw/1.1 var(--sans); font-variant-numeric: tabular-nums; }
.dt-stats span { font-size: 2.9cqw; color: var(--p-mut); white-space: nowrap; }
.dt-chart { position: relative; flex: 1; min-height: 0; margin-top: 4cqw; }
.dt-chart svg { width: 100%; height: 100%; }
.dt-fill { fill: color-mix(in srgb, var(--p-acc) 22%, transparent); }
.dt-line { fill: none; stroke: var(--p-acc); stroke-width: 2; vector-effect: non-scaling-stroke; }
.dt-scrub { position: absolute; top: 0; bottom: 0; left: 0; width: 0; border-left: 1.5px solid var(--p-ink); }
.dt-scrub b { position: absolute; bottom: 100%; translate: -50% -1cqw; padding: .6cqw 1.8cqw; border-radius: 2cqw; background: var(--p-ink); color: var(--p-bg); font: 600 3cqw/1.2 var(--sans); font-variant-numeric: tabular-nums; white-space: nowrap; }

/* lista przejazdów: grupa na karcie, nowy przejazd wjeżdża na górę */
.ph-rides { padding: 13cqw 4cqw 4cqw; display: flex; flex-direction: column; gap: 4cqw; }
.rl-title { font: 700 8cqw/1 var(--sans); letter-spacing: -.02em; padding-left: 1cqw; }
.rl-month { margin: 0 0 -2cqw 1cqw; font-size: 3.4cqw; color: var(--p-mut); }
.rl-month::first-letter { text-transform: uppercase; }
.rl-list { background: var(--p-card); border-radius: 5.5cqw; overflow: hidden; }
.rl-row { display: flex; align-items: center; gap: 3.2cqw; padding: 3cqw 3.4cqw; border-top: 1px solid var(--p-line); }
.rl-row:first-child { border-top: 0; }
.rl-row svg { flex: 0 0 13cqw; height: 13cqw; border-radius: 3cqw; background: var(--p-map); }
.rl-row path { fill: none; stroke: #F2553F; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
.rl-row div { display: grid; gap: .6cqw; min-width: 0; }
.rl-row b { font: 500 4cqw/1.2 var(--sans); }
.rl-row span { font-size: 3.3cqw; color: var(--p-mut); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rl-row.new { background: rgba(242,85,63,.12); }
.phone[data-screen='rides'] .rl-row { animation: rl-in .6s cubic-bezier(.3,.7,.2,1) backwards; }
.phone[data-screen='rides'] .rl-row:nth-child(2) { animation-delay: .06s; }
.phone[data-screen='rides'] .rl-row:nth-child(3) { animation-delay: .12s; }
.phone[data-screen='rides'] .rl-row:nth-child(4) { animation-delay: .18s; }
.phone[data-screen='rides'] .rl-row:nth-child(5) { animation-delay: .24s; }
.phone[data-screen='rides'] .rl-row:nth-child(6) { animation-delay: .3s; }
@keyframes rl-in { from { opacity: 0; translate: 0 6cqw; } }
.rl-local { margin-top: auto; display: flex; align-items: center; justify-content: center; gap: 2cqw; padding: 3.4cqw; border-radius: 5.5cqw; border: 1px dashed var(--p-line); font-size: 3.4cqw; color: var(--p-mut); text-align: center; }
.rl-local svg { flex: 0 0 6cqw; height: 6cqw; fill: none; stroke: var(--p-acc); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
@media (prefers-reduced-motion: reduce) { .ph-view { transition: none; } .phone[data-screen='rides'] .rl-row { animation: none; } }
</style>
